<%- include('../partials/header') %>

<div class="container">
  <div style="text-align:center;padding:3rem 1rem;max-width:600px;margin:0 auto">
    <div style="font-size:6rem">🎉</div>
    <h1 style="margin:1rem 0">多謝您嘅訂單！</h1>
    <p style="color:var(--gray-700);margin-bottom:2rem">
      訂單編號：<strong><%= order.order_no %></strong><br>
      我哋已經收到您嘅訂單，稍後會有專人聯絡您確認送貨安排 🐻
    </p>

    <div style="background:white;padding:2rem;border-radius:var(--radius);box-shadow:var(--shadow);text-align:left;margin-bottom:2rem">
      <h3 style="margin-bottom:1rem">📦 訂單詳情</h3>
      <div style="border-bottom:1px solid var(--gray-200);padding-bottom:1rem;margin-bottom:1rem">
        <% items.forEach(item => { %>
          <% const snap = JSON.parse(item.product_snapshot || '{}') %>
          <div style="display:flex;justify-content:space-between;padding:0.5rem 0">
            <span><%= snap.name || '產品' %> × <%= item.qty %></span>
            <span><%= store.currency %><%= item.subtotal.toFixed(2) %></span>
          </div>
        <% }) %>
      </div>
      <div style="display:flex;justify-content:space-between"><span>小計</span><span><%= store.currency %><%= order.subtotal.toFixed(2) %></span></div>
      <% if (order.discount > 0) { %>
        <div style="display:flex;justify-content:space-between;color:var(--bear-green)">
          <span>優惠</span><span>- <%= store.currency %><%= order.discount.toFixed(2) %></span>
        </div>
      <% } %>
      <div style="display:flex;justify-content:space-between"><span>運費</span><span><%= store.currency %><%= order.shipping_fee.toFixed(2) %></span></div>
      <div style="display:flex;justify-content:space-between;font-weight:800;font-size:1.25rem;margin-top:0.5rem;border-top:1px solid var(--gray-200);padding-top:1rem">
        <span>總額</span><span style="color:var(--bear-red)"><%= store.currency %><%= order.total.toFixed(2) %></span>
      </div>
    </div>

    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
      <a href="/user/orders" class="btn btn-primary">📋 查看訂單</a>
      <a href="/products" class="btn btn-outline">繼續購物</a>
    </div>

    <% if (order.payment_method !== 'cod' && order.payment_status === 'pending') { %>
      <div style="margin-top:2rem;padding:1rem;background:#FEF3C7;border-radius:var(--radius)">
        ⚠️ 您選擇咗線上付款，請 <a href="/checkout/pay/<%= order.id %>">按此完成付款</a>
      </div>
    <% } %>

    <div style="margin-top:3rem;padding:1.5rem;background:var(--bear-cream);border-radius:var(--radius)">
      🎁 <strong>想再慳多啲？</strong> 推薦朋友嚟買嘢，您都可以賺 5% 回贈！
      <a href="/user/referral" style="display:inline-block;margin-left:0.5rem;color:var(--bear-red);font-weight:700">
        攞您嘅推薦連結 →
      </a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>