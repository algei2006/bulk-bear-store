<%- include('../partials/header') %>

<div class="container">
  <h1 style="margin:2rem 0">📦 我的訂單</h1>

  <% if (orders.length === 0) { %>
    <div style="text-align:center;padding:4rem;background:white;border-radius:var(--radius)">
      <div style="font-size:4rem">📦</div>
      <p style="margin:1rem 0;color:var(--gray-500)">您仲未有訂單</p>
      <a href="/products" class="btn btn-primary">去購物</a>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>訂單編號</th>
            <th>日期</th>
            <th>金額</th>
            <th>狀態</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(order => { %>
            <tr>
              <td><strong><%= order.order_no %></strong></td>
              <td><%= new Date(order.created_at).toLocaleDateString('zh-HK') %></td>
              <td><%= store.currency %><%= order.total.toFixed(2) %></td>
              <td><span class="status status-<%= order.status %>"><%= order.status %></span></td>
              <td><a href="/user/orders/<%= order.id %>" class="btn btn-outline" style="padding:0.25rem 0.75rem;font-size:0.75rem">查看</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>