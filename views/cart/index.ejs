<%- include('../partials/header') %>

<div class="container cart-page">
  <h1 style="margin-bottom:2rem">🛒 我的購物車</h1>

  <% if (!cart.items || cart.items.length === 0) { %>
    <div style="text-align:center;padding:4rem 1rem;background:white;border-radius:var(--radius);box-shadow:var(--shadow-sm)">
      <div style="font-size:5rem;margin-bottom:1rem">🐻</div>
      <h2>購物車空空的</h2>
      <p style="color:var(--gray-500);margin:1rem 0 2rem">快啲去掃啲平嘢返嚟啦！</p>
      <a href="/products" class="btn btn-primary btn-lg">🛍️ 去購物</a>
    </div>
  <% } else { %>
    <div style="display:grid;grid-template-columns:1fr 360px;gap:2rem" class="cart-layout">
      <div>
        <div class="cart-items">
          <% cart.items.forEach(item => { %>
            <div class="cart-item">
              <div class="image">📦</div>
              <div>
                <div style="font-weight:600"><%= item.name %></div>
                <div style="font-size:0.875rem;color:var(--gray-500)"><%= item.sku %></div>
                <div style="font-weight:700;color:var(--bear-red);margin-top:0.5rem">
                  <%= store.currency %><%= item.unit_price.toFixed(2) %> × <%= item.qty %>
                </div>
              </div>
              <form action="/cart/update" method="post" style="display:flex;gap:0.5rem;align-items:center">
                <input type="hidden" name="product_id" value="<%= item.product_id %>">
                <input type="number" name="qty" value="<%= item.qty %>" min="1" style="width:60px;padding:0.375rem;border:1px solid var(--gray-300);border-radius:8px;text-align:center">
                <button type="submit" class="btn btn-outline" style="padding:0.375rem 0.75rem;font-size:0.875rem">更新</button>
              </form>
              <div style="display:flex;flex-direction:column;align-items:end;gap:0.5rem">
                <div style="font-weight:800;font-size:1.125rem;color:var(--bear-red)">
                  <%= store.currency %><%= item.subtotal.toFixed(2) %>
                </div>
                <form action="/cart/remove" method="post">
                  <input type="hidden" name="product_id" value="<%= item.product_id %>">
                  <button type="submit" style="color:var(--gray-500);font-size:0.75rem">🗑️ 移除</button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>

        <form action="/cart/coupon" method="post" style="margin-top:1.5rem;background:white;padding:1.25rem;border-radius:var(--radius);box-shadow:var(--shadow-sm);display:flex;gap:0.5rem;align-items:end">
          <div class="form-group" style="flex:1;margin:0">
            <label>優惠碼</label>
            <input type="text" name="code" placeholder="輸入優惠碼" class="form-control" style="text-transform:uppercase">
          </div>
          <button type="submit" class="btn btn-secondary">套用</button>
        </form>

        <% if (cart.coupon) { %>
          <div class="alert alert-success" style="margin-top:1rem">
            ✅ 已套用優惠碼 <strong><%= cart.coupon.code %></strong> - <%= cart.coupon.description %>
            <form action="/cart/coupon/remove" method="post" style="display:inline">
              <button type="submit" style="color:var(--bear-red);text-decoration:underline;margin-left:0.5rem">移除</button>
            </form>
          </div>
        <% } %>
      </div>

      <div>
        <div class="cart-summary">
          <h3 style="margin-bottom:1rem">📋 訂單摘要</h3>
          <div class="row">
            <span>小計 (<%= cart.items.reduce((s,i)=>s+i.qty,0) %> 件)</span>
            <span><%= store.currency %><%= cart.subtotal.toFixed(2) %></span>
          </div>
          <div class="row">
            <span>運費</span>
            <span style="color:var(--gray-500)">結賬時計算</span>
          </div>
          <% if (cart.coupon) { %>
            <div class="row" style="color:var(--bear-green)">
              <span>優惠折扣</span>
              <span>將於結賬時計算</span>
            </div>
          <% } %>
          <div class="row total">
            <span>預計總額</span>
            <span><%= store.currency %><%= cart.subtotal.toFixed(2) %>+</span>
          </div>
          <a href="/checkout" class="btn btn-primary btn-block btn-lg" style="margin-top:1rem">
            🔒 去結賬
          </a>
          <a href="/products" class="btn btn-outline btn-block" style="margin-top:0.5rem">
            ← 繼續購物
          </a>
        </div>
      </div>
    </div>
  <% } %>
</div>

<style>
@media (max-width:768px) {
  .cart-layout { grid-template-columns: 1fr !important; }
}
</style>

<%- include('../partials/footer') %>