<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <title><%= title %> - 批發熊後台</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="admin-layout">
    <aside class="admin-sidebar">
      <a href="/admin" class="logo">
        <img src="/images/logo.jpg" alt="批發熊" class="logo-img">
        <div class="logo-text">
          <span class="logo-zh">批發熊</span>
          <span class="logo-en">Admin</span>
        </div>
      </a>

      <h4 style="color:rgba(255,255,255,0.5);font-size:0.75rem;text-transform:uppercase;margin:1.5rem 0.875rem 0.5rem">主控台</h4>
      <a href="/admin" class="<%= path === '/admin' ? 'active' : '' %>">📊 儀表板</a>
      <a href="/admin/orders" class="<%= path.startsWith('/admin/orders') ? 'active' : '' %>">📦 訂單管理</a>
      <a href="/admin/products" class="<%= path.startsWith('/admin/products') ? 'active' : '' %>">🛍️ 產品管理</a>
      <a href="/admin/categories" class="<%= path.startsWith('/admin/categories') ? 'active' : '' %>">📚 分類管理</a>

      <h4 style="color:rgba(255,255,255,0.5);font-size:0.75rem;text-transform:uppercase;margin:1.5rem 0.875rem 0.5rem">營銷</h4>
      <a href="/admin/coupons" class="<%= path.startsWith('/admin/coupons') ? 'active' : '' %>">🎫 優惠碼</a>
      <a href="/admin/shipping" class="<%= path.startsWith('/admin/shipping') ? 'active' : '' %>">🚚 送貨設定</a>

      <h4 style="color:rgba(255,255,255,0.5);font-size:0.75rem;text-transform:uppercase;margin:1.5rem 0.875rem 0.5rem">客戶</h4>
      <a href="/admin/users" class="<%= path.startsWith('/admin/users') ? 'active' : '' %>">👥 會員管理</a>

      <div style="margin-top:auto;padding-top:2rem;border-top:1px solid rgba(255,255,255,0.1);margin-top:2rem">
        <a href="/" style="font-size:0.875rem">🌐 前往前台</a>
        <a href="/auth/logout" style="font-size:0.875rem">🚪 登出</a>
      </div>
    </aside>

    <main class="admin-main">
      <% if (typeof flash !== 'undefined' && flash) { %>
        <div class="alert alert-<%= flash.type %>"><%= flash.message %></div>
      <% } %>