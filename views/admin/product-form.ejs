<%- include('layout') %>

<h1 style="margin-bottom:1.5rem"><%= product ? '編輯' : '新增' %>產品</h1>

<div style="background:white;padding:2rem;border-radius:var(--radius);box-shadow:var(--shadow-sm);max-width:900px">
  <form action="<%= product ? '/admin/products/' + product.id : '/admin/products' %>" method="post">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
      <div class="form-group">
        <label>產品名稱 *</label>
        <input type="text" name="name" class="form-control" required value="<%= product ? product.name : '' %>">
      </div>
      <div class="form-group">
        <label>SKU *</label>
        <input type="text" name="sku" class="form-control" required value="<%= product ? product.sku : '' %>">
      </div>
      <div class="form-group">
        <label>URL Slug *</label>
        <input type="text" name="slug" class="form-control" required value="<%= product ? product.slug : '' %>">
      </div>
      <div class="form-group">
        <label>分類</label>
        <select name="category_id" class="form-control">
          <option value="">無</option>
          <% categories.forEach(c => { %>
            <option value="<%= c.id %>" <%= product && product.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label>產品描述</label>
      <textarea name="description" class="form-control" rows="3"><%= product ? product.description || '' : '' %></textarea>
    </div>

    <div class="form-group">
      <label>圖片 URL</label>
      <input type="text" name="image" class="form-control" value="<%= product ? product.image || '' : '' %>" placeholder="/images/product.jpg 或 https://...">
    </div>

    <h3 style="margin:1.5rem 0 0.5rem">💰 價格階梯</h3>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
      <div class="form-group">
        <label>原價 *</label>
        <input type="number" step="0.01" name="price" class="form-control" required value="<%= product ? product.price : '' %>">
      </div>
      <div class="form-group">
        <label>庫存</label>
        <input type="number" name="stock" class="form-control" value="<%= product ? product.stock : 0 %>">
      </div>
      <div class="form-group">
        <label>批發價 (起)</label>
        <input type="number" step="0.01" name="wholesale_price" class="form-control" value="<%= product ? product.wholesale_price || '' : '' %>">
      </div>
      <div class="form-group">
        <label>批發起訂量</label>
        <input type="number" name="min_wholesale_qty" class="form-control" value="<%= product ? product.min_wholesale_qty || 10 : 10 %>">
      </div>
      <div class="form-group">
        <label>第2階數量</label>
        <input type="number" name="tier2_qty" class="form-control" value="<%= product ? product.tier2_qty || '' : '' %>">
      </div>
      <div class="form-group">
        <label>第2階價格</label>
        <input type="number" step="0.01" name="tier2_price" class="form-control" value="<%= product ? product.tier2_price || '' : '' %>">
      </div>
      <div class="form-group">
        <label>第3階數量</label>
        <input type="number" name="tier3_qty" class="form-control" value="<%= product ? product.tier3_qty || '' : '' %>">
      </div>
      <div class="form-group">
        <label>第3階價格</label>
        <input type="number" step="0.01" name="tier3_price" class="form-control" value="<%= product ? product.tier3_price || '' : '' %>">
      </div>
    </div>

    <div style="display:flex;gap:1.5rem;margin:1rem 0">
      <label style="display:flex;align-items:center;gap:0.5rem">
        <input type="checkbox" name="featured" value="1" <%= product && product.featured ? 'checked' : '' %>> 精選產品
      </label>
      <label style="display:flex;align-items:center;gap:0.5rem">
        <input type="radio" name="active" value="1" <%= !product || product.active ? 'checked' : '' %>> 上架
      </label>
      <label style="display:flex;align-items:center;gap:0.5rem">
        <input type="radio" name="active" value="0" <%= product && !product.active ? 'checked' : '' %>> 下架
      </label>
    </div>

    <div style="display:flex;gap:0.5rem">
      <button type="submit" class="btn btn-primary">儲存</button>
      <a href="/admin/products" class="btn btn-outline">取消</a>
    </div>
  </form>
</div>

</main></div></body></html>