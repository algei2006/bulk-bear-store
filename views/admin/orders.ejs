<%- include('layout') %>

<h1 style="margin-bottom:1.5rem">📦 訂單管理</h1>

<div style="display:flex;gap:0.5rem;margin-bottom:1rem;flex-wrap:wrap">
  <a href="/admin/orders" class="btn <%= !status ? 'btn-primary' : 'btn-outline' %>" style="padding:0.375rem 0.875rem;font-size:0.875rem">全部</a>
  <a href="/admin/orders?status=pending" class="btn <%= status === 'pending' ? 'btn-primary' : 'btn-outline' %>" style="padding:0.375rem 0.875rem;font-size:0.875rem">待處理</a>
  <a href="/admin/orders?status=paid" class="btn <%= status === 'paid' ? 'btn-primary' : 'btn-outline' %>" style="padding:0.375rem 0.875rem;font-size:0.875rem">已付款</a>
  <a href="/admin/orders?status=shipped" class="btn <%= status === 'shipped' ? 'btn-primary' : 'btn-outline' %>" style="padding:0.375rem 0.875rem;font-size:0.875rem">已出貨</a>
  <a href="/admin/orders?status=completed" class="btn <%= status === 'completed' ? 'btn-primary' : 'btn-outline' %>" style="padding:0.375rem 0.875rem;font-size:0.875rem">已完成</a>
</div>

<div class="table-wrap">
  <table class="table">
    <thead>
      <tr><th>訂單</th><th>客戶</th><th>金額</th><th>付款</th><th>狀態</th><th>日期</th><th></th></tr>
    </thead>
    <tbody>
      <% orders.forEach(o => { %>
        <tr>
          <td><strong><%= o.order_no %></strong></td>
          <td><%= o.user_name %><br><span style="font-size:0.75rem;color:var(--gray-500)"><%= o.phone || '' %></span></td>
          <td><%= store.currency %><%= o.total.toFixed(2) %></td>
          <td><span class="status status-<%= o.payment_status === 'paid' ? 'paid' : 'pending' %>"><%= o.payment_method %></span></td>
          <td><span class="status status-<%= o.status %>"><%= o.status %></span></td>
          <td><%= new Date(o.created_at).toLocaleDateString('zh-HK') %></td>
          <td><a href="/admin/orders/<%= o.id %>" class="btn btn-outline" style="padding:0.25rem 0.75rem;font-size:0.75rem">查看</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

</main></div></body></html>