<%- include('layout') %>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem">
  <h1>🎫 優惠碼管理</h1>
  <button onclick="document.getElementById('newCoupon').style.display='block'" class="btn btn-primary">+ 新增優惠碼</button>
</div>

<div id="newCoupon" style="display:none;background:white;padding:1.5rem;border-radius:var(--radius);box-shadow:var(--shadow-sm);margin-bottom:1.5rem">
  <h3>新增優惠碼</h3>
  <form action="/admin/coupons" method="post" style="margin-top:1rem">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem">
      <input type="text" name="code" placeholder="優惠碼 (例：WELCOME10)" class="form-control" required>
      <select name="type" class="form-control" required>
        <option value="percentage">百分比折扣 (%)</option>
        <option value="fixed">固定金額折扣</option>
      </select>
      <input type="number" step="0.01" name="value" placeholder="折扣值" class="form-control" required>
      <input type="number" step="0.01" name="min_order" placeholder="最低訂單金額" class="form-control" value="0">
      <input type="number" name="max_uses" placeholder="使用次數上限" class="form-control">
      <input type="datetime-local" name="valid_until" class="form-control">
      <input type="text" name="description" placeholder="描述" class="form-control" style="grid-column:1/-1">
    </div>
    <button type="submit" class="btn btn-primary" style="margin-top:0.75rem">新增</button>
  </form>
</div>

<div class="table-wrap">
  <table class="table">
    <thead><tr><th>優惠碼</th><th>類型</th><th>值</th><th>最低</th><th>已用/上限</th><th>到期</th><th>狀態</th><th></th></tr></thead>
    <tbody>
      <% coupons.forEach(c => { %>
        <tr>
          <td><strong><%= c.code %></strong><br><span style="font-size:0.75rem;color:var(--gray-500)"><%= c.description || '' %></span></td>
          <td><%= c.type === 'percentage' ? '百分比' : '固定金額' %></td>
          <td><%= c.type === 'percentage' ? c.value + '%' : store.currency + c.value.toFixed(2) %></td>
          <td><%= c.min_order > 0 ? store.currency + c.min_order.toFixed(2) : '-' %></td>
          <td><%= c.used_count %> / <%= c.max_uses || '∞' %></td>
          <td><%= c.valid_until ? new Date(c.valid_until).toLocaleDateString('zh-HK') : '永久' %></td>
          <td>
            <span class="status status-<%= c.active ? 'completed' : 'cancelled' %>">
              <%= c.active ? '啟用' : '停用' %>
            </span>
          </td>
          <td style="display:flex;gap:0.25rem">
            <form action="/admin/coupons/<%= c.id %>/toggle" method="post">
              <button class="btn btn-outline" style="padding:0.25rem 0.5rem;font-size:0.75rem">切換</button>
            </form>
            <form action="/admin/coupons/<%= c.id %>/delete" method="post" onsubmit="return confirm('刪除？')">
              <button class="btn btn-outline" style="padding:0.25rem 0.5rem;font-size:0.75rem;color:var(--bear-red)">刪除</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

</main></div></body></html>